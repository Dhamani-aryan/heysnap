{
  "name": "@ank1015-app/desktop",
  "version": "0.1.0",
  "private": true,
  "productName": "HeySnap",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "cross-env VITE_CLOUD_SERVER_URL=http://localhost:4100 CLOUD_SERVER_URL=http://localhost:4100 electron-vite dev",
    "dev:hosted": "cross-env VITE_CLOUD_SERVER_URL=https://api.heysnap.xyz CLOUD_SERVER_URL=https://api.heysnap.xyz electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:mac:arm64": "pnpm build && electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:win:x64": "pnpm build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ank1015-app/server": "workspace:*",
    "@ank1015-app/ui": "workspace:*",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "trash": "^10.1.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "35.7.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "vite": "^6.3.3"
  },
  "build": {
    "appId": "xyz.heysnap.desktop",
    "productName": "HeySnap",
    "electronVersion": "35.7.5",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.heysnap.xyz/desktop/stable"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
