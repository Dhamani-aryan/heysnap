{
  "name": "@ank1015-app/server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/runtime.ts"
  },
  "types": "./src/runtime.ts",
  "scripts": {
    "dev": "pnpm --filter @ank1015-app/previewer build && tsx watch src/index.ts",
    "build": "pnpm --filter @ank1015-app/previewer build && tsc -p tsconfig.json",
    "docker:build": "docker build -f Dockerfile -t ank1015-machine-server:development ../..",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@ank1015-app/previewer": "workspace:*",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "chokidar": "^5.0.0",
    "trash": "^10.1.1",
    "ws": "^8.20.0"
  }
}
