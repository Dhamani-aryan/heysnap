#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_PATH="${ANK1015_MACHINE_COMMON_SH:-}"
if [ -z "$COMMON_PATH" ]; then
  if [ -f "$SCRIPT_DIR/../lib/ank1015-machine-common.sh" ]; then
    COMMON_PATH="$SCRIPT_DIR/../lib/ank1015-machine-common.sh"
  else
    COMMON_PATH="/usr/local/lib/ank1015-machine-bootstrap/ank1015-machine-common.sh"
  fi
fi
# shellcheck disable=SC1090
. "$COMMON_PATH"

ank1015_machine_common_version_or_continue "${1:-}"
ank1015_machine_load_env

ensure_user_and_directories() {
  groupadd -f ank1015
  groupadd -f docker

  if ! id -u agent >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --groups ank1015,docker agent
  else
    usermod -aG ank1015,docker agent || true
  fi

  install -d -m 0750 -o root -g ank1015 "$(ank1015_machine_root)"
  install -d -m 0755 -o agent -g agent "$ANK1015_FILESYSTEM_ROOT"
  install -d -m 0755 -o agent -g agent "$HOME"
  install -d -m 0700 -o agent -g agent "$HOME/.codex"
  install -d -m 0755 -o agent -g agent "$ANK1015_ACTIVE_SKILLS_DIR"
  install -d -m 0755 -o root -g root "$(ank1015_machine_release_dir)"
  install -d -m 0775 -o root -g ank1015 "$ANK1015_CAPABILITIES_ROOT"
  install -d -m 0775 -o root -g ank1015 "$ANK1015_AGENT_TOOLS_ROOT"
  install -d -m 0775 -o root -g ank1015 "$ANK1015_AGENT_TOOLS_BIN_DIR"
  install -d -m 0775 -o root -g ank1015 "$ANK1015_AGENT_TOOLS_ROOT/installed"
  install -d -m 0775 -o root -g ank1015 "$(dirname "$ANK1015_AGENT_SKILLS_CATALOG_DIR")"
  install -d -m 0775 -o root -g ank1015 "$ANK1015_AGENT_SKILLS_CATALOG_DIR"
}

install_systemd_units() {
  cat >/etc/systemd/system/ank1015-machine-server.service <<SERVICE
[Unit]
Description=ank1015 machine server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
SupplementaryGroups=ank1015 docker
EnvironmentFile=$(ank1015_machine_env_file)
WorkingDirectory=$ANK1015_FILESYSTEM_ROOT
ExecStartPre=+/usr/local/bin/ank1015-machine-release latest
ExecStart=/usr/bin/node $(ank1015_machine_current_link)/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

  cat >/etc/systemd/system/ank1015-machine-heartbeat.service <<SERVICE
[Unit]
Description=ank1015 machine registration, heartbeat, and updates
After=network-online.target ank1015-machine-server.service
Wants=network-online.target ank1015-machine-server.service

[Service]
Type=simple
EnvironmentFile=$(ank1015_machine_env_file)
WorkingDirectory=$(ank1015_machine_root)
ExecStart=/usr/local/bin/ank1015-machine-heartbeat
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

  systemctl daemon-reload
  systemctl enable --now ank1015-machine-server.service
  systemctl enable --now ank1015-machine-heartbeat.service
}

ensure_user_and_directories
chmod 0640 "$(ank1015_machine_env_file)"
chown root:ank1015 "$(ank1015_machine_env_file)" 2>/dev/null || true
ank1015_machine_set_update_state "idle"
install_systemd_units
